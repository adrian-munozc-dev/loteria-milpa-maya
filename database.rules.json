{
  "rules": {
    "salas": {
      "$code": {
        ".read": "auth != null && data.child('hostUid').val() === auth.uid",
        ".write": "auth != null && data.child('hostUid').val() === auth.uid",
        "hostUid": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "pub": { ".read": "auth != null" },
        "jugadores": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "name": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "marks": { ".write": "auth != null && auth.uid === $uid" },
            "conn": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "reclamo": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['id', 'at'])"
          }
        },
        "resp": {
          "$uid": { ".read": "auth != null && auth.uid === $uid" }
        }
      }
    }
  }
}
